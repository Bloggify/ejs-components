<meta charset="UTF-8">
<title>
  <%= title %> | <%= Bloggify.options.title %>
</title>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="csrf-token" content="<%= ctx.csrfToken %>">
<%- Bloggify.assets.cssHtml() %>
